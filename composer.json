{
    "name": "calcbloc/calcbloc",
    "description": "PHP client for the CalcBloc tax API, with official income tax brackets, social security rates and payroll tax tables bundled for offline use. Every figure cites its official source.",
    "type": "library",
    "keywords": [
        "tax",
        "income tax",
        "income tax brackets",
        "tax brackets",
        "tax tables",
        "tax rates",
        "tax tables 2026",
        "social security",
        "social security rates",
        "payroll",
        "payroll tax",
        "net salary",
        "take-home pay",
        "employer cost",
        "tax api",
        "calcbloc"
    ],
    "homepage": "https://calcbloc.com/developers?utm_source=calcbloc-php&utm_medium=package&utm_campaign=itmarkerz-oss",
    "license": "MIT",
    "authors": [
        {
            "name": "CalcBloc",
            "homepage": "https://calcbloc.com"
        }
    ],
    "support": {
        "issues": "https://github.com/itmarkerz/calcbloc-php/issues",
        "source": "https://github.com/itmarkerz/calcbloc-php",
        "docs": "https://calcbloc.com/developers?utm_source=calcbloc-php&utm_medium=package&utm_campaign=itmarkerz-oss"
    },
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5 || ^11.5",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0"
    },
    "suggest": {
        "ext-curl": "Default HTTP transport for the API client (PHP streams are used without it).",
        "psr/http-client-implementation": "Any PSR-18 client can be used through CalcBloc\\Http\\Psr18Transport."
    },
    "autoload": {
        "psr-4": {
            "CalcBloc\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CalcBloc\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "sync-tables": "@php bin/sync-tables.php",
        "coverage-table": "@php bin/coverage-table.php"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
